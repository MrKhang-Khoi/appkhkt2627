<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_app_item_card"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <!-- ICON BỌC TRONG SQUIRCLE -->
    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_device_card"
        android:layout_marginEnd="12dp">

        <TextView
            android:id="@+id/tvItemAppIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="📱"
            android:textSize="20sp" />
    </FrameLayout>

    <!-- THÔNG TIN TÊN & PHÂN LOẠI / THỜI GIAN MỞ -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvItemAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tên Ứng Dụng"
            android:textColor="#F8FAFC"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/tvItemAppCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mạng xã hội"
                android:textColor="#64748B"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" • "
                android:textColor="#475569"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvItemAppLastUsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="09:51 hôm nay"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- CỘT PHẢI: THỜI LƯỢNG & TRẠNG THÁI -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        android:layout_marginStart="8dp">

        <TextView
            android:id="@+id/tvItemAppDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="45 phút"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvItemAppStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:background="#334155"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="⚪ ĐÃ ĐÓNG"
            android:textColor="#94A3B8"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
