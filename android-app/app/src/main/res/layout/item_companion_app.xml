<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_device_card"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <!-- DÒNG 1: TÊN ỨNG DỤNG + BADGE ONLINE / OFFLINE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tvItemAppIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌐"
            android:textSize="20sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvItemAppName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="YouTube"
            android:textColor="#F8FAFC"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvItemAppStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#14532D"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="🟢 ONLINE"
            android:textColor="#86EFAC"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- DÒNG 2: THỜI GIAN SỬ DỤNG HÔM NAY (XUỐNG DÒNG) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="3dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏱️ Thời gian mở hôm nay: "
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvItemAppDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 giờ 15 phút (75p)"
            android:textColor="#FBBF24"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- DÒNG 3: LẦN MỞ GẦN NHẤT & PHÂN LOẠI -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🕒 Lần mở gần nhất: "
            android:textColor="#64748B"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvItemAppLastUsed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="09:51 hôm nay"
            android:textColor="#CBD5E1"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvItemAppCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mạng xã hội"
            android:textColor="#38BDF8"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
