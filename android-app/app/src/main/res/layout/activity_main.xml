<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ========================================================== -->
            <!-- 1. TOP HEADER BAR: LOGO + APP TITLE + DISCREET CLOUD BADGE -->
            <!-- ========================================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="18dp">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_launcher"
                    android:contentDescription="Logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CVA-SmartGuardian"
                    android:textColor="#F8FAFC"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginStart="10dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- CLOUD ICON BADGE VỚI CHẤM XANH TRỰC TUYẾN -->
                <FrameLayout
                    android:id="@+id/btnHeaderCloudBadge"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_cloud_badge"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="☁️"
                        android:textSize="15sp" />

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/bg_pin_dot_filled" />
                </FrameLayout>
            </LinearLayout>

            <!-- ========================================================== -->
            <!-- 2. SEGMENTED CONTROL: 2 TABS [ PHỤ HUYNH ] | [ HỌC SINH ]  -->
            <!-- ========================================================== -->
            <LinearLayout
                android:id="@+id/layoutSegmentedControl"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_tab_container"
                android:orientation="horizontal"
                android:padding="4dp"
                android:layout_marginBottom="20dp">

                <!-- TAB 1: PHỤ HUYNH -->
                <TextView
                    android:id="@+id/btnTabParent"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tab_active"
                    android:text="👨‍👩‍👧 Phụ Huynh"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- TAB 2: HỌC SINH -->
                <TextView
                    android:id="@+id/btnTabStudent"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tab_inactive"
                    android:text="🎒 Học Sinh"
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- ========================================================== -->
            <!-- 3. VIEW TAB 1: PHỤ HUYNH                                  -->
            <!-- ========================================================== -->
            <LinearLayout
                android:id="@+id/layoutTabParentContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- SCREEN 1: PARENT SECURITY PIN GATE -->
                <LinearLayout
                    android:id="@+id/layoutParentPinGate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="24dp"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Parent Security PIN"
                        android:textColor="#F8FAFC"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="22dp" />

                    <!-- 4 CHẤM PIN TRÒN PHÁT SÁNG VÀNG KIM -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="26dp">

                        <View
                            android:id="@+id/pinDot1"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_margin="10dp"
                            android:background="@drawable/bg_pin_dot_empty" />

                        <View
                            android:id="@+id/pinDot2"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_margin="10dp"
                            android:background="@drawable/bg_pin_dot_empty" />

                        <View
                            android:id="@+id/pinDot3"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_margin="10dp"
                            android:background="@drawable/bg_pin_dot_empty" />

                        <View
                            android:id="@+id/pinDot4"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_margin="10dp"
                            android:background="@drawable/bg_pin_dot_empty" />
                    </LinearLayout>

                    <!-- THÔNG BÁO LỖI PIN NẾU CÓ -->
                    <TextView
                        android:id="@+id/tvParentPinError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#EF4444"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        android:layout_marginBottom="12dp" />

                    <!-- BÀN PHÍM CẢM ỨNG TRÒN TO CHUẨN M3 (3x4) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">

                        <!-- Hàng 1: 1, 2, 3 -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/key1"
                                android:layout_width="66dp"
                                android:layout_height="66dp"
                                android:layout_margin="8dp"
                                android:background="@drawable/bg_numpad_key"
                                android:text="1"
                                android:textColor="#F8FAFC"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/key2"
                                android:layout_width="66dp"
                                android:layout_height="66dp"
                                android:layout_margin="8dp"
                                android:background="@drawable/bg_numpad_key"
                                android:text="2"
                                android:textColor="#F8FAFC"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/key3"
                                android:layout_width="66dp"
                                android:layout_height="66dp"
                                android:layout_margin="8dp"
                                android:background="@drawable/bg_numpad_key"
                                android:text="3"
                                android:textColor="#F8FAFC"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:clickable="true"
                                android:focusable="true" />
                        </LinearLayout>

                        <!-- Hàng 2: 4, 5, 6 -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/key4"
                                android:layout_width="66dp"
                                android:layout_height="66dp"
                                android:layout_margin="8dp"
                                android:background="@drawable/bg_numpad_key"
                                android:text="4"
                                android:textColor="#F8FAFC"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/key5"
                                android:layout_width="66dp"
                                android:layout_height="66dp"
                                android:layout_margin="8dp"
                                android:background="@drawable/bg_numpad_key"
                                android:text="5"
                                android:textColor="#F8FAFC"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/key6"
                                android:layout_width="66dp"
                                android:layout_height="66dp"
                                android:layout_margin="8dp"
                                android:background="@drawable/bg_numpad_key"
                                android:text="6"
                                android:textColor="#F8FAFC"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:clickable="true"
                                android:focusable="true" />
                        </LinearLayout>

                        <!-- Hàng 3: 7, 8, 9 -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/key7"
                                android:layout_width="66dp"
                                android:layout_height="66dp"
                                android:layout_margin="8dp"
                                android:background="@drawable/bg_numpad_key"
                                android:text="7"
                                android:textColor="#F8FAFC"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/key8"
                                android:layout_width="66dp"
                                android:layout_height="66dp"
                                android:layout_margin="8dp"
                                android:background="@drawable/bg_numpad_key"
                                android:text="8"
                                android:textColor="#F8FAFC"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/key9"
                                android:layout_width="66dp"
                                android:layout_height="66dp"
                                android:layout_margin="8dp"
                                android:background="@drawable/bg_numpad_key"
                                android:text="9"
                                android:textColor="#F8FAFC"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:clickable="true"
                                android:focusable="true" />
                        </LinearLayout>

                        <!-- Hàng 4: Clear, 0, Backspace -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/keyClear"
                                android:layout_width="66dp"
                                android:layout_height="66dp"
                                android:layout_margin="8dp"
                                android:background="@drawable/bg_numpad_key"
                                android:text="Clear"
                                android:textColor="#38BDF8"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/key0"
                                android:layout_width="66dp"
                                android:layout_height="66dp"
                                android:layout_margin="8dp"
                                android:background="@drawable/bg_numpad_key"
                                android:text="0"
                                android:textColor="#F8FAFC"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/keyBackspace"
                                android:layout_width="66dp"
                                android:layout_height="66dp"
                                android:layout_margin="8dp"
                                android:background="@drawable/bg_numpad_key"
                                android:text="⌫"
                                android:textColor="#38BDF8"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:clickable="true"
                                android:focusable="true" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mã PIN bảo mật mặc định: 1234"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:layout_marginTop="16dp" />
                </LinearLayout>

                <!-- SCREEN 2: PARENT HUB (KHI ĐÃ NHẬP ĐÚNG PIN) -->
                <LinearLayout
                    android:id="@+id/layoutParentHub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Parent Hub"
                        android:textColor="#F8FAFC"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="16dp" />

                    <!-- THẺ VÀNG KIM MÃ GIA ĐÌNH CHUẨN SCREEN 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_gold_card"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:layout_marginBottom="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🏅"
                            android:textSize="32sp"
                            android:layout_marginEnd="14dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MÃ GIA ĐÌNH:"
                                android:textColor="#FCD34D"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.06" />

                            <TextView
                                android:id="@+id/tvParentHubFamilyCode"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CVA-8A20"
                                android:textColor="#FBBF24"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- NÚT SAO CHÉP VÀ ĐỔI MÃ PHỤ TRỢ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/btnParentCopyCode"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_device_card"
                            android:text="📋 Sao Chép Mã"
                            android:textColor="#93C5FD"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:paddingLeft="14dp"
                            android:paddingRight="14dp"
                            android:layout_marginEnd="10dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/btnParentRegenCode"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_device_card"
                            android:text="🔄 Đổi Mã Mới"
                            android:textColor="#94A3B8"
                            android:textSize="12sp"
                            android:gravity="center"
                            android:paddingLeft="14dp"
                            android:paddingRight="14dp"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <!-- THẺ TRẠNG THÁI THIẾT BỊ CON (PAIRED CHILD) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_device_card"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="14dp"
                        android:layout_marginBottom="24dp">

                        <!-- AVATAR ICON CÓ CHẤM XANH -->
                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_tab_container"
                            android:layout_marginEnd="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="👤"
                                android:textSize="16sp" />

                            <View
                                android:id="@+id/dotParentChildOnline"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:layout_gravity="bottom|end"
                                android:background="@drawable/bg_pin_dot_filled" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ghép Đôi"
                                android:textColor="#F8FAFC"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvParentChildSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Paired child • Xiaomi 25069PTEBG"
                                android:textColor="#94A3B8"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="#64748B"
                            android:textSize="20sp" />
                    </LinearLayout>

                    <!-- KHU VỰC HÀNH ĐỘNG BẢO VỆ: NGẮT KẾT NỐI -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔒 Protected"
                            android:textColor="#EF4444"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/btnParentTriggerUnpair"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_danger_pill"
                            android:text="Ngắt Kết Nối"
                            android:textColor="#EF4444"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <!-- NÚT KHÓA LẠI TAB PHỤ HUYNH -->
                    <TextView
                        android:id="@+id/btnLockParentTab"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔒 Khóa Bảng Điều Khiển"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="16dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- ========================================================== -->
            <!-- 4. VIEW TAB 2: HỌC SINH (SCREEN 3)                         -->
            <!-- ========================================================== -->
            <LinearLayout
                android:id="@+id/layoutTabStudentContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- CARD "STUDENT" CHUẨN SCREEN 3 -->
                <LinearLayout
                    android:id="@+id/layoutStudentCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:padding="22dp"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Student"
                        android:textColor="#F8FAFC"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enter code"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:layout_marginBottom="8dp" />

                    <!-- Ô NHẬP CVA-XXXX -->
                    <EditText
                        android:id="@+id/etPairingCodeInput"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:background="@drawable/bg_input_field"
                        android:textColor="#F8FAFC"
                        android:textColorHint="#475569"
                        android:hint="CVA-XXXX"
                        android:gravity="center"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        android:textAllCaps="true"
                        android:inputType="textCapCharacters|textNoSuggestions"
                        android:layout_marginBottom="18dp"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp" />

                    <!-- NÚT KẾT NỐI CYAN PHÁT SÁNG -->
                    <TextView
                        android:id="@+id/btnConnectPairing"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_pill_button"
                        android:text="🔗 KẾT NỐI"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- VÒNG LOADING XOAY -->
                    <ProgressBar
                        android:id="@+id/pbPairingLoading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="12dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvPairingStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:textColor="#34D399"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- TEXT TRẠNG THÁI "Xin chào ............, ĐÃ GHÉP ĐÔI" -->
                <LinearLayout
                    android:id="@+id/layoutStudentGreetingGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Xin chào ............ ,"
                        android:textColor="#94A3B8"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvCompanionBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ĐÃ GHÉP ĐÔI"
                        android:textColor="#F8FAFC"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- THẺ THỐNG KÊ RÈN LUYỆN (HIỆN KHI ĐÃ GHÉP ĐÔI) -->
                <LinearLayout
                    android:id="@+id/layoutStudentStatsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Học tập"
                                android:textColor="#94A3B8"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/tvStudyTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 phút"
                                android:textColor="#38BDF8"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Giải trí"
                                android:textColor="#94A3B8"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/tvGameTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 phút"
                                android:textColor="#F59E0B"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Điểm cân bằng:"
                            android:textColor="#94A3B8"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvBalanceScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100/100"
                            android:textColor="#10B981"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- NÚT TRỢ GIÚP XIAOMI + NÚT CẬP NHẬT -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:id="@+id/btnXiaomiHelp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ℹ️ Trợ giúp quyền Xiaomi HyperOS / Android 14"
                        android:textColor="#93C5FD"
                        android:textSize="11sp"
                        android:background="@drawable/bg_device_card"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:layout_marginBottom="12dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btnCheckUpdate"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_device_card"
                        android:text="🔄 Kiểm Tra Bản Cập Nhật"
                        android:textColor="#34D399"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginBottom="16dp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ============================================================== -->
    <!-- MODAL CONFIRM NHẬP PIN KHI PHỤ HUYNH BẤM NGẮT KẾT NỐI          -->
    <!-- ============================================================== -->
    <FrameLayout
        android:id="@+id/layoutPinConfirmModal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D907090E"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️"
                android:textSize="32sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xác Nhận Ngắt Kết Nối"
                android:textColor="#F8FAFC"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nhập mã PIN Phụ huynh để xác nhận:"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginBottom="14dp" />

            <EditText
                android:id="@+id/etModalPinConfirm"
                android:layout_width="140dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_input_field"
                android:textColor="#F8FAFC"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:inputType="numberPassword"
                android:maxLength="4"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvModalPinError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#EF4444"
                android:textSize="11sp"
                android:visibility="gone"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnModalCancelUnpair"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_device_card"
                    android:text="Hủy"
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnModalConfirmUnpair"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_danger_pill"
                    android:text="Ngắt Ngay"
                    android:textColor="#EF4444"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ============================================================== -->
    <!-- OVERLAY LOADING KHI PHỤ HUYNH HOẶC THIẾT BỊ ĐANG NGẮT KẾT NỐI   -->
    <!-- ============================================================== -->
    <FrameLayout
        android:id="@+id/layoutUnpairOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#EB07090E"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_glass_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="#EF4444"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thông Báo Từ Phụ Huynh"
                android:textColor="#EF4444"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Phụ huynh đã ngắt kết nối thiết bị này.\nĐang hoàn tất đăng xuất và làm mới dữ liệu..."
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
