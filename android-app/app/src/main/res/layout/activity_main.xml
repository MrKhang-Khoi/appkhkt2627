<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TIÊU ĐỀ ỨNG DỤNG -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/ic_lock"
                android:tint="@color/primary"
                android:contentDescription="Logo"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CVA-SmartGuardian"
                    android:textColor="@color/text_main"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hệ thống bảo vệ &amp; đồng hành số học sinh"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLiveStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ĐANG BẢO VỆ"
                android:textColor="@color/success"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@color/surface"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </LinearLayout>

        <!-- THẺ THỐNG KÊ HÔM NAY -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/surface"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TỔNG QUAN THỜI GIAN HÔM NAY"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvStudyTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0p"
                        android:textColor="@color/success"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Học tập"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvGameTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0p"
                        android:textColor="@color/danger"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Game / MXH"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvBalanceScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100"
                        android:textColor="@color/accent_gold"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Điểm Cân Bằng"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvTotalScreenTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tổng thời gian sáng màn hình: 0 giờ 0 phút"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_gravity="center_horizontal" />
        </LinearLayout>

        <!-- BANNER HƯỚNG DẪN MỞ KHÓA CHO XIAOMI / ANDROID 13+ (RESTRICTED SETTINGS) -->
        <LinearLayout
            android:id="@+id/cardXiaomiGuide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#261A0C"
            android:padding="14dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ MÁY BÁO &quot;ỨNG DỤNG BỊ TỪ CHỐI CẤP QUYỀN&quot;?"
                android:textColor="@color/accent_gold"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Do tính năng bảo mật của Android 14 / Xiaomi HyperOS đối với file APK:\n1. Bấm nút bên dưới để mở thẳng trang Thông Tin Ứng Dụng\n2. Nhìn góc trên bên phải ➔ Bấm dấu 3 chấm (⋮)\n3. Chọn &quot;Cho phép cài đặt bị hạn chế&quot; ➔ Xác nhận 10s là cấp quyền được ngay 100%!"
                android:textColor="@color/text_main"
                android:textSize="11sp"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp" />

            <Button
                android:id="@+id/btnOpenAppInfo"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="👉 BẤM ĐÂY ĐỂ MỞ THÔNG TIN ỨNG DỤNG"
                android:textColor="@color/on_primary"
                android:backgroundTint="#B45309"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- TIÊU ĐỀ PHÂN MỤC CÀI ĐẶT QUYỀN -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="THIẾT LẬP BẢO VỆ (PHỤ HUYNH THỰC HIỆN)"
            android:textColor="@color/accent_gold"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- MỤC 1: QUYỀN TRUY CẬP DỮ LIỆU SỬ DỤNG (USAGE ACCESS) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/surface"
            android:padding="14dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Đo lường ứng dụng (Usage Stats)"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ghi nhận thời gian học tập &amp; chơi game"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnPermissionUsage"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Cấp Quyền"
                android:textColor="@color/on_primary"
                android:backgroundTint="@color/primary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- MỤC 2: QUYỀN TRỢ NĂNG (ACCESSIBILITY SERVICE) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/surface"
            android:padding="14dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Trợ năng chặn Web xấu (Accessibility)"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tự động phát hiện &amp; chặn web khiêu dâm, cờ bạc"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnPermissionAccessibility"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Cấp Quyền"
                android:textColor="@color/on_primary"
                android:backgroundTint="@color/primary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- MỤC 3: TƯỜNG LỬA DNS AN TOÀN (VPN) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/surface"
            android:padding="14dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3. Tường lửa DNS An toàn (VPN Safe)"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lọc tên miền độc hại trên toàn bộ máy"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnToggleVpn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Bật Lá Chắn"
                android:textColor="@color/on_primary"
                android:backgroundTint="@color/primary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- MỤC 4: QUẢN TRỊ VIÊN THIẾT BỊ (DEVICE ADMIN) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/surface"
            android:padding="14dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4. Chống gỡ cài đặt (Device Admin)"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Yêu cầu mã PIN cha mẹ nếu học sinh muốn gỡ app"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnPermissionAdmin"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Kích Hoạt"
                android:textColor="@color/on_primary"
                android:backgroundTint="@color/primary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- KHỐI ĐỊNH DANH THIẾT BỊ & GHÉP ĐÔI HỌC SINH -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/surface"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📱 ĐỊNH DANH THIẾT BỊ &amp; GHÉP ĐÔI HỌC SINH"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDeviceIdentityInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thiết bị: Đang tải... | Mã ghép đôi: CVA-8A2"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btnViewInstalledApps"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="📊 Thống Kê Ứng Dụng Đã Cài Đặt (Phân Loại)"
                android:textColor="@color/on_primary"
                android:backgroundTint="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- NÚT KẾT NỐI BẢNG ĐIỀU KHIỂN PHỤ HUYNH -->
        <Button
            android:id="@+id/btnOpenDashboard"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="🌐 Mở Bảng Điều Khiển Phụ Huynh (Web)"
            android:textColor="@color/on_primary"
            android:backgroundTint="@color/accent_gold"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

    </LinearLayout>
</ScrollView>
