<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_modern"
    android:padding="20dp">

    <!-- 1. TIÊU ĐỀ DIALOG & HERO SCORE PILL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <!-- AVATAR SQUIRCLE ĐỒNG BỘ -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_avatar_squircle"
            android:layout_marginEnd="12dp">

            <TextView
                android:id="@+id/tvDialogChildAvatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="👦"
                android:textSize="22sp" />
        </FrameLayout>

        <!-- THÔNG TIN TÊN & TRẠNG THÁI -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDialogChildTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Giám Sát Thiết Bị Con"
                android:textColor="#F8FAFC"
                android:textSize="17sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvDialogChildSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟢 Đang kết nối • Thời gian thực"
                android:textColor="#34D399"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- ĐIỂM CÂN BẰNG SỐ (SCORE PILL) -->
        <LinearLayout
            android:id="@+id/layoutDialogBalanceContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_score_pill"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="10dp"
            android:paddingRight="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/tvDialogBalanceScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚖️ 85/100"
                android:textColor="#FBBF24"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. BANNER TRẠNG THÁI HIỆN TẠI (ACTIVE FOREGROUND APP LIVE) -->
    <LinearLayout
        android:id="@+id/layoutDialogActiveAppBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_device_card"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:layout_marginBottom="14dp">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_glass_card"
            android:layout_marginEnd="10dp">

            <TextView
                android:id="@+id/tvActiveAppIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="⚡"
                android:textSize="18sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvActiveAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TRẠNG THÁI THIẾT BỊ CON:"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/tvActiveAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đang đồng bộ telemetry từ thiết bị con..."
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvActiveAppLiveBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#334155"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="⚪ CHỜ ĐỒNG BỘ" />
    </LinearLayout>

    <!-- 3. THANH CHỌN TAB CHUYÊN NGHIỆP DẠNG PILL (CHỐNG RỚT DÒNG) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/bg_tab_container"
        android:orientation="horizontal"
        android:padding="3dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tabDialogSocial"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_active"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="🌐 Mạng XH"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tabDialogStudy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_inactive"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="📚 Học tập"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tabDialogGame"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_inactive"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="🎮 Game"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tabDialogAll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_inactive"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="📱 Tất cả"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- 4. DANH SÁCH ỨNG DỤNG CUỘN (TRIỆT TIÊU KHOẢNG TRỐNG CHẾT) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/layoutDialogAppListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- EMPTY STATE TINH TẾ & ẤM ÁP -->
            <LinearLayout
                android:id="@+id/layoutDialogEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_device_card"
                android:paddingTop="24dp"
                android:paddingBottom="24dp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvDialogEmptyIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☕"
                    android:textSize="32sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvDialogEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chưa có hoạt động trong nhóm này"
                    android:textColor="#F8FAFC"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvDialogEmptyDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thiết bị con chưa mở ứng dụng thuộc danh mục này hôm nay."
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/btnDialogViewAllApps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tab_container"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="📱 Khám phá tất cả ứng dụng"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 5. HÀNH ĐỘNG ĐÁY: GỬI LỜI NHẮC & ĐÓNG -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnDialogSendMessage"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_primary_modern"
            android:text="💌 Gửi Lời Nhắc Nhở"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginEnd="10dp" />

        <Button
            android:id="@+id/btnDialogClose"
            android:layout_width="95dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_btn_secondary_modern"
            android:text="Đóng"
            android:textColor="#CBD5E1"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
