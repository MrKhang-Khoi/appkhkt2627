<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#0F172A"
    android:padding="20dp">

    <!-- TIÊU ĐỀ DIALOG -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛡️"
            android:textSize="24sp"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDialogChildTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Giám Sát Thiết Bị Con"
                android:textColor="#F8FAFC"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDialogChildSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟢 Đang kết nối • Xiaomi 25069PTEBG"
                android:textColor="#34D399"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDialogBalanceScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tab_container"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="⚖️ 85/100"
            android:textColor="#FBBF24"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- THANH CHỌN TAB CHUYÊN BIỆT CHỐNG RỚT DÒNG -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/bg_tab_container"
        android:orientation="horizontal"
        android:padding="3dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/tabDialogSocial"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_active"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="🌐 Mạng XH"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tabDialogStudy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_inactive"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="📚 Học tập"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tabDialogGame"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_inactive"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="🎮 Game"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tabDialogAll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_inactive"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="📱 Tất cả"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- BANNER TRẠNG THÁI HIỆN TẠI (ACTIVE FOREGROUND APP / ZERO-CONTRADICTION) -->
    <LinearLayout
        android:id="@+id/layoutDialogActiveAppBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gold_card"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvActiveAppIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡"
            android:textSize="20sp"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvActiveAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ỨNG DỤNG ĐANG MỞ TRÊN MÀN HÌNH:"
                android:textColor="#FDE047"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvActiveAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YouTube (Đang xem trực tiếp)"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvActiveAppLiveBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#15803D"
            android:textColor="#86EFAC"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="🟢 ONLINE" />
    </LinearLayout>

    <!-- DANH SÁCH CUỘN ỨNG DỤNG CHI TIẾT & EMPTY STATE -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/layoutDialogAppListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- EMPTY STATE CHUYÊN NGHIỆP: LOẠI TRỪ KHOẢNG TRỐNG ĐEN -->
            <LinearLayout
                android:id="@+id/layoutDialogEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="32dp"
                android:paddingBottom="32dp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvDialogEmptyIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☕"
                    android:textSize="36sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvDialogEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chưa có hoạt động trong nhóm này"
                    android:textColor="#F8FAFC"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvDialogEmptyDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thiết bị con chưa mở ứng dụng thuộc danh mục này hôm nay."
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/btnDialogViewAllApps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tab_container"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="📱 Xem tất cả ứng dụng"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- HÀNH ĐỘNG: GỬI LỜI NHẮC & ĐÓNG -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDialogSendMessage"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_button"
            android:text="💌 Gửi Nhắc Nhở"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnDialogClose"
            android:layout_width="90dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_device_card"
            android:text="Đóng"
            android:textColor="#94A3B8"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
